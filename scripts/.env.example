# Copy to scripts/.env and fill in. .env is gitignored.

# Contentful Content Management API token
# Create at https://app.contentful.com/account/profile/cma_tokens
CONTENTFUL_CMA_TOKEN=

# Contentful Space ID (visible in Contentful URL after /spaces/)
CONTENTFUL_SPACE_ID=

# Contentful environment (usually "master")
CONTENTFUL_ENVIRONMENT=master
